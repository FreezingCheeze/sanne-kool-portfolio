---
import Navigation from './Navigation.astro';
import MobileNavigation from './MobileNavigation.astro';
import { site } from '../data/site';

interface Props {
	currentPath: string;
}

const { currentPath } = Astro.props;
---

<a class="skip-link" href="#main">Ga naar inhoud</a>
<header class="site-header">
	<div class="inner">
		<a class="brand" href="/">{site.brand}</a>
		<Navigation currentPath={currentPath} />
		<MobileNavigation currentPath={currentPath} />
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 40;
		height: var(--header-height);
		background: var(--color-header-bg);
		backdrop-filter: blur(12px);
		border-bottom: var(--border-width) solid var(--color-border);
	}

	.inner {
		width: min(var(--content-width-wide), 100% - var(--page-gutter) * 2);
		margin-inline: auto;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-lg);
	}

	.brand {
		text-decoration: none;
		font-family: var(--font-sans);
		font-size: var(--font-size-xs);
		font-weight: var(--font-weight-medium);
		letter-spacing: var(--letter-spacing-wide);
		white-space: nowrap;
	}

	.brand:hover {
		color: var(--color-text);
	}

	@media (max-width: 40rem) {
		.brand {
			white-space: normal;
			max-width: 14rem;
			line-height: 1.3;
		}
	}
</style>
