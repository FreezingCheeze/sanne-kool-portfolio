---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { projectHref, type Project } from '../lib/projects';

interface Props {
	project: Project;
}

const { project } = Astro.props;
const href = projectHref(project);
---

<article class="card">
	<a href={href}>
		<div class="media">
			<Image
				src={project.data.coverImage as ImageMetadata}
				alt={project.data.coverAlt}
				widths={[360, 540, 800]}
				sizes="(max-width: 48rem) 100vw, (max-width: 64rem) 50vw, 33vw"
			/>
		</div>
		<div class="copy">
			<h2>{project.data.title}</h2>
			<p>{project.data.summary}</p>
			<span class="more">Lees meer</span>
		</div>
	</a>
</article>

<style>
	.card a {
		display: grid;
		text-decoration: none;
		color: inherit;
		height: 100%;
		border: var(--border-width) solid var(--color-border);
		background: var(--color-bg);
		transition:
			transform var(--duration-base) var(--easing),
			box-shadow var(--duration-base) var(--easing);
	}

	.card a:hover,
	.card a:focus-visible {
		transform: translateY(-3px);
		box-shadow: var(--shadow-soft);
		color: inherit;
	}

	.media {
		aspect-ratio: 4 / 3;
		overflow: hidden;
		background: var(--color-bg-muted);
	}

	.media :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform var(--duration-slow) var(--easing);
	}

	.card a:hover .media :global(img) {
		transform: scale(1.04);
	}

	.copy {
		padding: var(--space-lg);
		display: grid;
		gap: var(--space-sm);
		align-content: start;
	}

	h2 {
		font-size: var(--font-size-lg);
		margin: 0;
	}

	p {
		margin: 0;
		color: var(--color-text-muted);
		font-size: var(--font-size-sm);
	}

	.more {
		margin-top: var(--space-sm);
		font-size: var(--font-size-xs);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		font-weight: var(--font-weight-medium);
		border-bottom: 1px solid currentColor;
		width: fit-content;
	}
</style>
