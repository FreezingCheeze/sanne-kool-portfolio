---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { projectHref, type Project } from '../lib/projects';

interface Props {
	project: Project;
	uniformHeight?: boolean;
}

const { project, uniformHeight = false } = Astro.props;
const href = projectHref(project);
---

<article class:list={['card', { 'card--uniform': uniformHeight }]}>
	<a href={href}>
		<div class="copy">
			<div class="headline">
				<h2>{project.data.title}</h2>
				<p>{project.data.summary}</p>
			</div>
			<span class="more">Lees meer</span>
		</div>
		<div class:list={['media', `media--${project.data.slug}`]}>
			<Image
				src={project.data.coverImage as ImageMetadata}
				alt={project.data.coverAlt}
				widths={[360, 540, 800, 1200]}
				sizes="(max-width: 48rem) 100vw, 50vw"
			/>
		</div>
	</a>
</article>

<style>
	.card a {
		display: grid;
		align-items: stretch;
		text-decoration: none;
		color: inherit;
		height: 100%;
		border-radius: var(--radius-md);
		overflow: hidden;
		background: var(--color-bg-muted);
		transition: box-shadow var(--duration-base) var(--easing);
	}

	.card a:hover,
	.card a:focus-visible {
		box-shadow: var(--shadow-soft);
		color: inherit;
	}

	.copy {
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: var(--space-sm);
		align-self: stretch;
		box-sizing: border-box;
		height: 100%;
		min-height: 100%;
		padding: var(--space-lg);
		padding-bottom: calc(var(--space-lg) + 2.5rem + var(--space-sm));
		background: var(--color-bg-muted);
		color: var(--color-secondary);
	}

	.headline {
		display: flex;
		flex-direction: column;
		gap: var(--space-sm);
		min-height: 0;
	}

	.media {
		aspect-ratio: 4 / 3;
		overflow: hidden;
		background: #0f172a;
	}

	.media :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	h2 {
		font-size: var(--font-size-lg);
		margin: 0;
		color: var(--color-secondary);
	}

	p {
		margin: 0;
		font-size: var(--font-size-sm);
	}

	.more {
		position: absolute;
		left: var(--space-lg);
		bottom: var(--space-lg);
		margin: 0;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 2.5rem;
		padding: 0.4rem 0.9rem;
		background: #ffffff;
		color: var(--color-panel);
		font-size: var(--font-size-xs);
		letter-spacing: 0.06em;
		text-transform: uppercase;
		font-weight: var(--font-weight-medium);
		border-radius: var(--radius-md);
		width: fit-content;
		transform-origin: center;
		transition:
			transform var(--duration-base) var(--easing),
			box-shadow var(--duration-base) var(--easing);
	}

	.card a:hover .more,
	.card a:focus-visible .more {
		transform: scale(1.08) translateY(-2px);
		box-shadow: 0 8px 18px rgba(30, 58, 138, 0.22);
	}

	@media (min-width: 40rem) {
		.card a {
			grid-template-columns: 1fr 1fr;
		}

		.media {
			aspect-ratio: auto;
			min-height: 100%;
		}

		.card--uniform a {
			height: 26rem;
			grid-template-rows: 1fr;
		}

		.card--uniform .copy {
			height: 100%;
			min-height: 0;
		}

		.card--uniform .copy p {
			overflow: hidden;
		}

		.card--uniform .media {
			min-height: 0;
			height: 100%;
			overflow: hidden;
		}
	}

	@media (max-width: 39.999rem) {
		.card--uniform .media {
			aspect-ratio: auto;
			height: 17rem;
		}
	}

	.media--freebee :global(img) {
		object-position: center 28%;
	}

	.media--foodblog :global(img) {
		transform: scale(1.25);
		transform-origin: center;
	}
</style>
