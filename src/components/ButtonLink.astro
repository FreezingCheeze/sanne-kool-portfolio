---
interface Props {
	href: string;
	external?: boolean;
	download?: boolean | string;
}

const { href, external = false, download = false } = Astro.props;
const downloadAttr = typeof download === 'string' ? download : undefined;
---

<a
	class="button-link"
	href={href}
	target={external || download === true ? '_blank' : undefined}
	rel={external ? 'noreferrer noopener' : undefined}
	download={downloadAttr}
>
	<slot />
</a>

<style>
	.button-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 2.75rem;
		padding: 0.55rem 1.35rem;
		border: var(--border-width-strong) solid var(--color-border-strong);
		background: var(--color-border-strong);
		color: var(--color-panel);
		text-decoration: none;
		font-size: var(--font-size-sm);
		font-weight: var(--font-weight-medium);
		letter-spacing: 0.04em;
		border-radius: var(--radius-md);
		transition:
			background-color var(--duration-base) var(--easing),
			color var(--duration-base) var(--easing);
	}

	.button-link:hover {
		background: var(--color-text);
		color: var(--color-text-on-dark);
		border-color: var(--color-text);
	}
</style>
