---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	id: string;
	images: Array<{
		src: ImageMetadata;
		alt: string;
		title?: string;
		text?: string;
	}>;
}

const { id, images } = Astro.props;
const slides = await Promise.all(
	images.map(async (image, index) => {
		const full = await getImage({ src: image.src, width: 2400 });
		return { ...image, index, lightboxSrc: full.src };
	}),
);
---

{
	images.length > 0 && (
		<div class="titled-gallery" data-titled-gallery>
			<div class="tabs" role="tablist" aria-label="Afbeeldingen">
				{slides.map((image, index) => {
					const selected = index === 0;
					return (
						<button
							type="button"
							class="tab"
							role="tab"
							id={`${id}-tab-${index}`}
							aria-controls={`${id}-panel-${index}`}
							aria-selected={selected ? 'true' : 'false'}
							tabindex={selected ? 0 : -1}
						>
							{image.title?.trim() || image.alt}
						</button>
					);
				})}
			</div>
			<div class="panels">
				{slides.map((image, index) => {
					const selected = index === 0;
					const paragraphs = image.text
						?.split(/\n\s*\n/)
						.map((paragraph) => paragraph.trim())
						.filter(Boolean);
					const hasCopy = Boolean(paragraphs && paragraphs.length > 0);
					return (
						<div
							class="panel"
							role="tabpanel"
							id={`${id}-panel-${index}`}
							aria-labelledby={`${id}-tab-${index}`}
							hidden={!selected}
						>
							<figure>
								<button
									type="button"
									class="zoom"
									data-lightbox-open
									data-lightbox-group={id}
									data-lightbox-src={image.lightboxSrc}
									data-lightbox-alt={image.alt}
									aria-label={`Vergroot: ${image.alt}`}
								>
									<Image
										src={image.src}
										alt={image.alt}
										widths={[480, 768, 1100, 1600]}
										sizes="(max-width: 48rem) 92vw, 55rem"
										loading={index === 0 ? 'eager' : 'lazy'}
									/>
								</button>
							</figure>
							<div class:list={['copy', { 'copy--filled': hasCopy }]}>
								{hasCopy && (
									<>
										{image.title && <h3 class="copy-title">{image.title}</h3>}
										{hasCopy &&
											paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
									</>
								)}
							</div>
						</div>
					);
				})}
			</div>
		</div>
	)
}

<script>
	function initTitledGallery(root: HTMLElement) {
		const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
		const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
		if (tabs.length === 0 || tabs.length !== panels.length) return;

		const select = (index: number) => {
			tabs.forEach((tab, i) => {
				const selected = i === index;
				tab.setAttribute('aria-selected', selected ? 'true' : 'false');
				tab.tabIndex = selected ? 0 : -1;
				panels[i].hidden = !selected;
			});
		};

		tabs.forEach((tab, index) => {
			tab.addEventListener('click', () => select(index));
			tab.addEventListener('keydown', (event) => {
				if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft' && event.key !== 'Home' && event.key !== 'End') {
					return;
				}
				event.preventDefault();
				const nextIndex =
					event.key === 'Home'
						? 0
						: event.key === 'End'
							? tabs.length - 1
							: event.key === 'ArrowRight'
								? (index + 1) % tabs.length
								: (index - 1 + tabs.length) % tabs.length;
				select(nextIndex);
				tabs[nextIndex].focus();
			});
		});
	}

	document.querySelectorAll<HTMLElement>('[data-titled-gallery]').forEach(initTitledGallery);
</script>

<style>
	.titled-gallery {
		display: flex;
		flex-direction: column;
		gap: var(--space-lg);
	}

	.tabs {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: var(--space-xs) var(--space-lg);
	}

	.tab {
		appearance: none;
		margin: 0;
		padding: 0.2rem 0;
		border: 0;
		border-bottom: var(--border-width-strong) solid transparent;
		background: transparent;
		color: inherit;
		font: inherit;
		font-size: var(--font-size-sm);
		font-weight: var(--font-weight-regular);
		letter-spacing: var(--letter-spacing-nav);
		line-height: var(--line-height-snug);
		cursor: pointer;
		opacity: 0.7;
		transition:
			opacity var(--duration-base) var(--easing),
			border-color var(--duration-base) var(--easing),
			font-weight var(--duration-base) var(--easing);
	}

	.tab:hover {
		opacity: 1;
		border-bottom-color: var(--color-accent);
	}

	.tab[aria-selected='true'] {
		opacity: 1;
		font-weight: var(--font-weight-medium);
		border-bottom-color: var(--color-text-on-dark);
	}

	.panel {
		display: grid;
		grid-template-columns: minmax(0, 1.7fr) minmax(12rem, 1fr);
		gap: var(--space-xl);
		align-items: start;
	}

	.panel[hidden] {
		display: none;
	}

	figure {
		margin: 0;
		background: transparent;
	}

	.titled-gallery :global(img) {
		width: 100%;
		height: auto;
	}

	.copy--filled {
		align-self: start;
		max-width: 24rem;
		padding: 0.15rem 0 0.15rem var(--space-lg);
		border-left: var(--border-width-strong) solid var(--color-border);
	}

	.copy-title {
		margin: 0 0 var(--space-sm);
		font-size: var(--font-size-lg);
		font-weight: var(--font-weight-medium);
		letter-spacing: -0.01em;
		color: var(--color-text-on-dark);
	}

	.copy p {
		margin: 0;
		font-size: var(--font-size-sm);
		font-weight: var(--font-weight-regular);
		line-height: var(--line-height-body);
		color: var(--color-accent);
	}

	.copy p + p {
		margin-top: var(--space-md);
	}

	@media (max-width: 47.99rem) {
		.panel {
			grid-template-columns: 1fr;
			gap: var(--space-md);
		}

		.copy--filled {
			max-width: none;
			padding: var(--space-md) 0 0;
			border-left: 0;
			border-top: var(--border-width-strong) solid var(--color-border);
		}
	}
</style>
