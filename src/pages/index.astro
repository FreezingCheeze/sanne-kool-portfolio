---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ButtonLink from '../components/ButtonLink.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { site } from '../data/site';
import portrait from '../assets/portrait/sanne-kool.jpg';
---

<BaseLayout>
	<section class="hero page-shell page-shell--wide">
		<figure class="portrait">
			<Image
				src={portrait}
				alt="Portret van Sanne Kool"
				widths={[320, 480, 760, 1100]}
				sizes="(max-width: 48rem) 80vw, 28rem"
				loading="eager"
				fetchpriority="high"
			/>
		</figure>
		<div class="intro">
			<p class="kicker">Mijn naam is</p>
			<h1>Sanne Kool.</h1>
			<p>
				Ik ben een enthousiaste grafisch vormgever, in 2025 afgestudeerd aan het ROC Midden Nederland.
				Tijdens mijn opleiding heb ik met veel plezier mijn creativiteit ontwikkeld en mijn liefde voor
				visuele communicatie ontdekt. Ik haal energie uit het vertalen van ideeën naar een sterke en
				herkenbare vormgeving.
			</p>
			<p>
				Op dit moment volg ik de opleiding Eventmanager aan de Hogeschool Utrecht (AD-vorm). Hiermee
				combineer ik mijn passie voor design met de dynamische wereld van evenementen. Ik geloof dat een
				goed ontworpen beleving begint bij een sterk visueel concept!
			</p>
			<div class="actions">
				<ButtonLink href="/opleiding-mediavormgeving/">Opleiding Mediavormgeving</ButtonLink>
				<ButtonLink href="/vrijwerk/">Vrijwerk</ButtonLink>
				<ButtonLink href={site.cvPath} download>CV</ButtonLink>
			</div>
			<SocialLinks compact />
		</div>
	</section>
</BaseLayout>

<style>
	.hero {
		display: grid;
		gap: var(--space-lg);
		padding-block: var(--space-2xl) var(--space-4xl);
		align-items: stretch;
	}

	.portrait {
		margin: 0;
		background: var(--color-bg-muted);
		display: grid;
		place-items: center;
		padding: var(--space-xl);
		border-radius: var(--radius-md);
	}

	.portrait :global(img) {
		width: min(100%, 28rem);
		aspect-ratio: 4 / 5;
		object-fit: cover;
		object-position: 50% 18%;
		border-radius: var(--radius-md);
	}

	.intro {
		background: var(--color-panel);
		color: var(--color-text-on-dark);
		padding: clamp(1.5rem, 4vw, 3rem);
		border-radius: var(--radius-md);
		display: grid;
		align-content: center;
	}

	.kicker {
		margin-bottom: 0;
		font-size: var(--font-size-lg);
		font-weight: var(--font-weight-semibold);
		color: var(--color-text-on-dark);
	}

	h1 {
		margin-top: 0;
		color: var(--color-text-on-dark);
	}

	.intro p {
		max-width: 40rem;
		color: var(--color-text-on-dark);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		align-items: stretch;
		gap: var(--space-md);
		margin: var(--space-xl) 0 var(--space-lg);
	}

	.actions :global(.button-link) {
		flex: 1 1 12rem;
	}

	.intro :global(.socials) {
		color: var(--color-text-on-dark);
	}

	@media (min-width: 64rem) {
		.hero {
			grid-template-columns: minmax(16rem, 1fr) minmax(0, 1.1fr);
			gap: var(--space-lg);
			padding-block: var(--space-3xl) var(--space-4xl);
		}
	}
</style>
