---
import BaseLayout from './BaseLayout.astro';
import ButtonLink from '../components/ButtonLink.astro';
import ProjectSocialLinks from '../components/ProjectSocialLinks.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectGallery from '../components/ProjectGallery.astro';
import TitledGallery from '../components/TitledGallery.astro';
import ImageLightbox from '../components/ImageLightbox.astro';
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import type { ImageMetadata } from 'astro';
import { splitProjectBody } from '../lib/projects';

interface Props {
	project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await render(project);
const { data } = project;
const showCards = data.cards.length > 0;
const { intro, afterTitle, afterParagraphs } = splitProjectBody(project.body ?? '');
const showAfterword = Boolean(afterTitle) && afterParagraphs.length > 0;
const afterwordLead = Boolean(afterParagraphs[0] && !/[.!?]$/.test(afterParagraphs[0]));
const backHref = data.parent
	? `/projects/${data.parent}/`
	: `/${data.category === 'opleiding' ? 'opleiding-mediavormgeving' : data.category}/`;
---

<BaseLayout
	title={data.title}
	description={data.summary}
	ogType="article"
	canonicalPath={`/projects/${data.slug}/`}
>
	<article class="project">
		<header class="page-shell page-shell--project page-intro">
			<p class="eyebrow">{data.client ?? data.category}{data.year ? ` · ${data.year}` : ''}</p>
			<h1>{data.title}</h1>
			<div class="lede">
				{
					showAfterword ? (
						intro.map((paragraph) => <p>{paragraph}</p>)
					) : (
						<Content />
					)
				}
			</div>
			{
				data.tools.length > 0 && (
					<ul class="tools">
						{data.tools.map((tool) => (
							<li>{tool}</li>
						))}
					</ul>
				)
			}
		</header>

		{
			(data.externalUrl ||
				data.instagramUrl ||
				data.facebookUrl ||
				(data.relatedHref && data.relatedLabel)) && (
				<div class="page-shell page-shell--project body social-row">
					{
						(data.instagramUrl || data.facebookUrl) && (
							<ProjectSocialLinks
								title={data.title}
								instagramUrl={data.instagramUrl}
								facebookUrl={data.facebookUrl}
							/>
						)
					}
					{
						data.externalUrl && (
							<p>
								<ButtonLink href={data.externalUrl} external>
									Bekijk gerelateerd werk
								</ButtonLink>
							</p>
						)
					}
					{
						data.relatedHref && data.relatedLabel && (
							<p>
								<ButtonLink href={data.relatedHref}>{data.relatedLabel}</ButtonLink>
							</p>
						)
					}
				</div>
			)
		}

		{
			showCards && (
				<section class="page-shell page-shell--cards cards">
					{data.cards.map((card) => (
						<ProjectCard
							card={{
								title: card.title,
								summary: card.summary,
								image: card.image as ImageMetadata,
								imageAlt: card.imageAlt,
								href: card.href,
							}}
							uniformHeight
						/>
					))}
				</section>
			)
		}

		{
			!showCards &&
				data.galleries.map((gallery, index) => (
					<section class="page-shell page-shell--project gallery-block">
						{gallery.title && <h2>{gallery.title}</h2>}
						{gallery.layout === 'titled' ? (
							<TitledGallery id={`titled-gallery-${index}`} images={gallery.images} />
						) : (
							<ProjectGallery
								id={`project-gallery-${index}`}
								images={gallery.images}
								imageScale={gallery.imageScale}
								uniform={gallery.uniform}
								stack={gallery.layout === 'stack'}
							/>
						)}
					</section>
				))
		}

		{
			data.videos.map((video) => (
				<section class="page-shell page-shell--project gallery-block">
					{video.title && <h2>{video.title}</h2>}
					<video class="project-video" controls playsinline preload="metadata" aria-label={video.alt}>
						<source src={video.src} type="video/mp4" />
					</video>
				</section>
			))
		}

		{
			showAfterword && (
				<section class="page-shell page-shell--project afterword">
					<h2>{afterTitle}</h2>
					{afterParagraphs.map((paragraph, index) => (
						<p class={index === 0 && afterwordLead ? 'afterword-lead' : undefined}>{paragraph}</p>
					))}
				</section>
			)
		}

		<div class="page-shell page-shell--project back">
			<ButtonLink href={backHref}>Terug naar overzicht</ButtonLink>
		</div>
	</article>
	<ImageLightbox />
</BaseLayout>

<style>
	.eyebrow {
		text-transform: uppercase;
		letter-spacing: var(--letter-spacing-wide);
		font-size: var(--font-size-xs);
		font-weight: var(--font-weight-medium);
		color: var(--color-accent);
		margin-bottom: var(--space-sm);
	}

	.tools {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-xs);
		list-style: none;
		padding: 0;
		margin: var(--space-lg) 0 0;
	}

	.tools li {
		border: var(--border-width) solid var(--color-border);
		padding: 0.2rem 0.6rem;
		font-size: var(--font-size-xs);
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.lede {
		max-width: none;
	}

	.lede :global(h2),
	.lede h2 {
		margin-top: var(--space-2xl);
	}

	.afterword {
		padding-bottom: var(--space-3xl);
		font-size: var(--font-size-sm);
		font-weight: var(--font-weight-regular);
		color: var(--color-text-on-dark);
	}

	.afterword h2 {
		margin-top: 0;
		margin-bottom: var(--space-md);
	}

	.afterword-lead {
		font-weight: var(--font-weight-medium);
	}

	.body {
		margin-bottom: var(--space-2xl);
		font-size: var(--font-size-md);
	}

	.social-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-md);
	}

	.social-row p {
		margin: 0;
	}

	.gallery-block {
		padding-bottom: var(--space-3xl);
	}

	.gallery-block h2 {
		margin-bottom: var(--space-md);
	}

	.project-video {
		width: 100%;
		background: var(--color-bg-muted);
	}

	.back {
		padding-bottom: var(--space-4xl);
	}
</style>
